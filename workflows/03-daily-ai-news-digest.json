{
  "name": "Daily AI News Digest",
  "nodes": [
    {
      "parameters": {
        "content": "## Daily AI News Digest\nEvery morning at 8:00 this pulls several RSS feeds, keeps only the last 24h, and has an LLM pick and summarise the 5 most important stories. The digest is sent to Telegram.\n\n**Setup:** add OpenAI and Telegram credentials, set your chat ID, and edit the feed list in *Feed List*.",
        "height": 220,
        "width": 420,
        "color": 4
      },
      "id": "3c9e4f20-0001-4d3a-9b30-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-60, -300]
    },
    {
      "parameters": {
        "rule": { "interval": [{ "triggerAtHour": 8 }] }
      },
      "id": "3c9e4f20-0002-4d3a-9b30-000000000002",
      "name": "Every Morning 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "return [\n  'https://hnrss.org/frontpage',\n  'https://techcrunch.com/category/artificial-intelligence/feed/',\n  'https://www.theverge.com/rss/ai-artificial-intelligence/index.xml',\n].map(url => ({ json: { url } }));"
      },
      "id": "3c9e4f20-0003-4d3a-9b30-000000000003",
      "name": "Feed List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {}
      },
      "id": "3c9e4f20-0004-4d3a-9b30-000000000004",
      "name": "Read RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json.isoDate }}",
              "rightValue": "={{ $now.minus({ days: 1 }).toISO() }}",
              "operator": { "type": "dateTime", "operation": "after" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3c9e4f20-0005-4d3a-9b30-000000000005",
      "name": "Last 24h Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "jsCode": "// Cap at 40 stories to keep the prompt small and cheap\nconst lines = $input.all().slice(0, 40).map(i =>\n  `- ${i.json.title} (${i.json.link})\\n  ${(i.json.contentSnippet || '').slice(0, 300)}`\n);\nreturn [{ json: { articles: lines.join('\\n'), count: lines.length } }];"
      },
      "id": "3c9e4f20-0006-4d3a-9b30-000000000006",
      "name": "Combine Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list", "cachedResultName": "GPT-4O-MINI" },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a tech newsletter editor. From the stories provided, pick the 5 most important for people working in AI and automation. For each: a bold-free title line, a 2-sentence plain-English summary, and the link. Start with a one-line greeting including today's date. Plain text only, no markdown."
            },
            {
              "content": "=Today's stories ({{ $json.count }}):\n\n{{ $json.articles }}"
            }
          ]
        },
        "options": { "temperature": 0.3 }
      },
      "id": "3c9e4f20-0007-4d3a-9b30-000000000007",
      "name": "Summarise Top 5 (AI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.message.content }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "3c9e4f20-0008-4d3a-9b30-000000000008",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1320, 0],
      "webhookId": "8d1f6c3b-2e4a-4b7c-9f0d-1a2b3c4d5e6f"
    }
  ],
  "connections": {
    "Every Morning 8:00": { "main": [[{ "node": "Feed List", "type": "main", "index": 0 }]] },
    "Feed List": { "main": [[{ "node": "Read RSS", "type": "main", "index": 0 }]] },
    "Read RSS": { "main": [[{ "node": "Last 24h Only", "type": "main", "index": 0 }]] },
    "Last 24h Only": { "main": [[{ "node": "Combine Articles", "type": "main", "index": 0 }]] },
    "Combine Articles": { "main": [[{ "node": "Summarise Top 5 (AI)", "type": "main", "index": 0 }]] },
    "Summarise Top 5 (AI)": { "main": [[{ "node": "Send to Telegram", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" }
}
